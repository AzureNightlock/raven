int[] items = ["apple", "banana", "cherry", "date"];

string searchText = "";



function renderList (searchText) => {items.filter(item => item.includes(searchText))}

createElement("ul") as ul{ 
  ul.onInput(() => {
    for (const item of renderList) {
      createElement("li") li {
        li.value = item
      }
    }
  })
}

signal int x = 5

createElement("p") ptag() {
  sync(ptag.value, x)
}
createElement("button") as incBtn {
  incBtn.onClick(() => x += 1)
}